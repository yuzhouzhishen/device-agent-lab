# Copy to .env when a demo needs real model access.
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=device-agent-lab

# Formal application runtime. The default is fully offline.
DEVICE_BACKEND=mock
DEVICE_PLANNER=auto
DEVICE_PLANNER_FALLBACK=true
DEVICE_CONTROL_MODE=approval
DEVICE_CONTROL_VERIFY_DELAY_SECONDS=0.75
DEVICE_CONTROL_VERIFY_ATTEMPTS=4
DEVICE_ID=DEMO-CP02-001
DEVICE_LABEL=当前设备
DEVICE_ALLOWED_PORTS=1,2,3,4,5
DEVICE_OPERATOR_ROLE=device-operator
DEVICE_AUDIT_PATH=var/audit.jsonl
DEVICE_SESSION_DB=var/sessions.sqlite3

# Local model planning. Set DEVICE_PLANNER=ollama to enable it.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
GENERAL_KNOWLEDGE_FALLBACK=true
GENERAL_KNOWLEDGE_TIMEOUT_SECONDS=45

# Standalone Firmware Knowledge Agent. Leave empty for the bundled
# deterministic fallback playbooks.
FIRMWARE_RAG_URL=
FIRMWARE_RAG_TIMEOUT_SECONDS=120

# Optional company/private MCP integration. Keep the full credential URL only
# in .env; never commit or paste it into source code or documentation.
XDP_MCP_URL=

# Optional pre-authorized device catalog. The file contains credentials and
# must stay under the Git-ignored var/ directory. Use /data paths in Docker.
DEVICE_PROFILES_FILE=
DEVICE_PROFILE_STATE=var/active-device-profile
