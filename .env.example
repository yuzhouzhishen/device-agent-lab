# Copy to .env when a demo needs real model access.
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=device-agent-lab

# Formal application runtime. The default is fully offline.
DEVICE_BACKEND=mock
DEVICE_PLANNER=auto
DEVICE_ID=DEMO-CP02-001
DEVICE_ALLOWED_PORTS=1,2,3
DEVICE_OPERATOR_ROLE=device-operator
DEVICE_AUDIT_PATH=var/audit.jsonl

# Optional company/private MCP integration. Keep the full credential URL only
# in .env; never commit or paste it into source code or documentation.
XDP_MCP_URL=
